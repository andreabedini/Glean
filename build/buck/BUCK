genrule(
    name = "schema-thrift-hs",
    out = "gen-hs2",
    cmd = "\n".join([
        "set -e",
        "D=`realpath $TMP`/src",
        "T=`realpath $TMP`/out",
        "mkdir -p $D $T",
        "cp -RL $(location {})/. $D/".format(GLEAN),
        "chmod -R u+w $D/glean/schema",
        "mkdir -p $D/glean/schema/thrift",
        "cp $(location :schema)/glean/schema/thrift/* $D/glean/schema/thrift/",
    ] + [
        "$(exe_target //:exe-thrift-compiler) --hs -I $D glean/schema/thrift/{}.thrift -o $T".format(s)
        for s in SCHEMAS
    ] + [
        "mv $T/gen-hs2 $OUT",
    ]),
    visibility = ["PUBLIC"],
)
